# ============================================================================
# Landing-page template env contract
# Server-only vars are read exclusively through lib/config.ts.
# Client vars (NEXT_PUBLIC_*) are inlined into the browser bundle at build time.
# All values below are examples/placeholders — do not commit real secrets.
# ============================================================================

# --- Brand / identity (server) ---
COMPANY_NAME="Your Home Buyers"
PHONE_DISPLAY="(800) 000-0000"
PHONE_HREF="8000000000"                       # digits only, used in tel: links
LOGO_URL=""                                    # falls back to COMPANY_NAME text when empty

# --- Accent color (server) ---
# Onboarding emits BRAND_ACCENT; ACCENT_COLOR is an optional override.
# Precedence: ACCENT_COLOR > BRAND_ACCENT > #ff6900 default.
BRAND_ACCENT="#ff6900"
# ACCENT_COLOR="#ff6900"
HEADER_BG_COLOR="#ffffff"

# --- Owner / founder (server) ---
OWNER_NAME=""                                  # e.g. "Jane Doe"
HEADSHOT_URL=""                                # small headshot
FOUNDERS_PHOTO_URL=""                          # hero cut-out photo; falls back to HEADSHOT_URL; hero photo hidden when empty
FOUNDERS_CAPTION=""                            # optional caption under the hero photo

# --- Hero copy (server) ---
HEADLINE="Sell Your House Fast For Cash"
HEADLINE_ACCENT=""                             # optional accent-colored second line
SUBHEADLINE="No repairs. No fees. A fair cash offer in 24 hours — you pick the closing date."
MARKET_NAME=""                                 # e.g. "Salt Lake City" — copy falls back to "your area" when empty

# --- Trust stats (server) ---
STAT_1_VALUE="1,000+"
STAT_1_LABEL="Homes Purchased"
STAT_2_VALUE="10+"
STAT_2_LABEL="Years in Business"
STAT_3_VALUE="5-Star"
STAT_3_LABEL="Google Rating"

# --- SEO / metadata (server) ---
META_TITLE=""                                  # defaults to "{COMPANY_NAME} | Sell Your House Fast For Cash"
META_DESCRIPTION=""                            # defaults to a generic cash-offer description

# --- Legal links (server) ---
PRIVACY_POLICY_URL="/privacy"
TERMS_URL="/terms"

# --- Disqualification config (server; defaults live in code / survey-card) ---
DISQUALIFIED_PROPERTY_TYPES="mobile-home,land,other"
DISQUALIFIED_OWNERSHIP_LENGTHS=""
ALLOWED_STATES=""
SMS_KEYWORD="OFFER"

# --- Lead delivery (server) ---
WEBHOOK_URL=""                                 # n8n / CRM webhook for lead fan-out

# --- Call-in number (client) ---
NEXT_PUBLIC_CALLIN_DISPLAY=""
NEXT_PUBLIC_CALLIN_HREF=""

# --- Meta Pixel (client) ---
# When empty, the pixel component renders nothing and fires no events.
NEXT_PUBLIC_FB_PIXEL_ID=""

# --- Google Places autocomplete (client) ---
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=""

# --- Service-area geofence (client) ---
# JSON array of circles: [{"lat":40.7608,"lng":-111.8910,"radiusMiles":30}]
# Empty/omitted => permissive gate (accepts any address, no geo-lock).
NEXT_PUBLIC_SERVICE_AREAS="[]"

# --- Optional media (client) ---
NEXT_PUBLIC_HERO_VIDEO_URL=""
NEXT_PUBLIC_YOUTUBE_IDS=""                     # comma-separated YouTube video ids

# --- GoFunnel attribution ---
# Client tracking script org id (NEXT_PUBLIC) + server-side external webhook creds.
# The code currently defaults these to the base client's ids — OVERRIDE per client.
NEXT_PUBLIC_GOFUNNEL_ORG_ID=""
GOFUNNEL_WEBHOOK_CREDENTIAL_ID=""
GOFUNNEL_WEBHOOK_SECRET=""                     # set to "" to disable the GoFunnel fan-out

# --- Feature flags ---
V3_ENABLED=""                                  # no v3 route ships in this template; reserved

# --- Deal Oracle (set by onboarding; NOT used by the landing page) ---
DEAL_ORACLE_API_KEY=""
DEAL_ORACLE_CLIENT_ID=""
